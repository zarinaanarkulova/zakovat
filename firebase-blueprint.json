{
  "entities": {
    "Question": {
      "title": "Question",
      "description": "An intellectual game question",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "The question title or shorthand visible on the grid"
        },
        "text": {
          "type": "string",
          "description": "The question text"
        },
        "mediaType": {
          "type": "string",
          "enum": ["text", "image", "video"],
          "description": "The type of media associated with the question"
        },
        "mediaUrl": {
          "type": "string",
          "format": "uri",
          "description": "The URL of the image or video"
        },
        "answer": {
          "type": "string",
          "description": "The correct answer"
        },
        "order": {
          "type": "integer",
          "description": "Used for shuffling and ordering"
        }
      },
      "required": ["text", "mediaType", "answer", "title"]
    }
  },
  "firestore": {
    "questions/{questionId}": {
      "schema": "Question",
      "description": "A collection of questions for the Zakovat game"
    },
    "settings/gameConfig": {
      "schema": {
        "type": "object",
        "properties": {
          "teams": {
            "type": "array",
            "items": { "type": "string" }
          },
          "teamScores": {
            "type": "object",
            "additionalProperties": { "type": "integer" }
          }
        }
      },
      "description": "Global game settings and scores"
    }
  }
}
